{
  "name": "@examples/react-custom-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter . run --parallel \"/^dev:(client|server)$/\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=../../.env --clear-screen=false src/app.ts",
    "build:internal": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-sdk": "^1.10.2",
    "@langchain/openai": "^1.5.11",
    "@langchain/protocol": "^0.0.19",
    "@langchain/react": "^1.0.35",
    "hono": "^4.13.7",
    "langchain": "^1.5.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}