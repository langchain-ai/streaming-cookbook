{
  "name": "@examples/react-custom-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter . run --parallel \"/^dev:(client|server)$/\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=../../.env --clear-screen=false src/app.ts",
    "build:internal": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-sdk": "^1.15.0",
    "@langchain/openai": "^1.8.2",
    "@langchain/protocol": "^0.0.21",
    "@langchain/react": "^1.2.13",
    "hono": "^4.13.17",
    "langchain": "^1.6.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}