{
  "name": "@examples/react-custom-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter . run --parallel \"/^dev:(client|server)$/\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=../../.env --clear-screen=false src/app.ts",
    "build:internal": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@langchain/core": "1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-sdk": "^1.9.29",
    "@langchain/openai": "^1.5.8",
    "@langchain/protocol": "^0.0.18",
    "@langchain/react": "^1.0.30",
    "hono": "^4.13.2",
    "langchain": "^1.5.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}